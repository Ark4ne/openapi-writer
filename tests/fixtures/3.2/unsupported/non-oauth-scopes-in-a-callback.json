{
    "openapi": "3.2.0",
    "info": {
        "title": "Compatibility",
        "version": "1.0.0"
    },
    "paths": {
        "/hooks": {
            "post": {
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                },
                "callbacks": {
                    "onEvent": {
                        "{$request.body#/url}": {
                            "post": {
                                "responses": {
                                    "200": {
                                        "description": "OK"
                                    }
                                },
                                "security": [
                                    {
                                        "ApiKey": [
                                            "read"
                                        ]
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "ApiKey": {
                "type": "apiKey",
                "name": "X-API-Key",
                "in": "header"
            }
        }
    }
}
