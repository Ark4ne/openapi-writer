{
    "openapi": "3.2.0",
    "info": {
        "title": "Validation",
        "version": "1.0.0"
    },
    "paths": {
        "/users": {
            "get": {
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "ApiKey": {
                "type": "apiKey",
                "name": "X-API-Key",
                "in": "header"
            },
            "OAuth2": {
                "type": "oauth2",
                "flows": {
                    "clientCredentials": {
                        "tokenUrl": "https://example.com/oauth/token",
                        "scopes": {
                            "read": "Read access"
                        }
                    }
                }
            },
            "Shared": {
                "$ref": "#/components/securitySchemes/OAuth2"
            },
            "OpenId": {
                "type": "openIdConnect",
                "openIdConnectUrl": "https://example.com/.well-known/openid-configuration"
            }
        }
    },
    "security": [
        {
            "#/components/securitySchemes/ApiKey": []
        },
        {
            "#/components/securitySchemes/Gone": []
        },
        {
            "https://example.com/schemes#/Remote": []
        },
        {
            "Shared": [
                "admin"
            ]
        },
        {
            "OpenId": [
                "anything"
            ]
        }
    ]
}
