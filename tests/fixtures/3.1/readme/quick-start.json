{
    "openapi": "3.1.2",
    "info": {
        "title": "Users API",
        "version": "1.0.0"
    },
    "paths": {
        "/users/{id}": {
            "get": {
                "operationId": "users.show",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "type": "object",
                "required": [
                    "id",
                    "email"
                ],
                "properties": {
                    "id": {
                        "format": "int64",
                        "type": "integer",
                        "readOnly": true
                    },
                    "email": {
                        "format": "email",
                        "type": "string"
                    },
                    "nickname": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        }
    }
}
