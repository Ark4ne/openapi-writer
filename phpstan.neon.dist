includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - bin
    tmpDir: build/phpstan
    ignoreErrors:
        # Until M6: the validation bodies are still neutral, so their documented @throws are not thrown yet.
        -
            identifier: throws.unusedType
            path: src/Validation/*

services:
    -
        class: Ark4ne\OpenApiWriter\Tests\Architecture\ArchitectureTest
        tags:
            - phpat.test
